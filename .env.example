# Create two free-tier Gemini API keys at https://aistudio.google.com/apikey.
# Replace both PASTE_... values with your real keys; do not enable paid billing.
# Keep them comma-separated on this one line and never commit .env.
LLM_API_KEYS=PASTE_FIRST_GEMINI_KEY_HERE,PASTE_SECOND_GEMINI_KEY_HERE
LLM_MODEL=gemini/gemini-3.5-flash-lite
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
ENABLE_FAILURE_SIMULATION=true
LLM_TIMEOUT_SECONDS=15
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant for an Indian small business. Always reply in clear, natural English unless the customer explicitly asks for another language.
VITE_API_BASE_URL=http://localhost:8000

